    // ==================== 绉佹湁杈呭姪鏂规硶 ====================

    /**
     * 鑾峰彇浠婃棩鏍囨湰鎬绘暟锛堝甫缂撳瓨锛?     */
    private Long getTodaySampleCount() {
        String cacheKey = TODAY_STATS_CACHE_KEY + ":todayCount";
        Long count = redisUtils.get(cacheKey);
        
        if (count == null) {
            count = baseMapper.countToday();
            redisUtils.setEx(cacheKey, count, 300); // 缂撳瓨5鍒嗛挓
        }
        
        return count;
    }

    /**
     * 鑾峰彇寰呭鐞嗘爣鏈暟
     */
    private Long getPendingSampleCount() {
        // 寰呭鐞嗙姸鎬侊細宸查噰闆嗐€佽繍杈撲腑銆佸凡鎺ユ敹
        return this.lambdaQuery()
                .in(Sample::getStatus, Arrays.asList(
                        SampleStatusConstant.COLLECTED,
                        SampleStatusConstant.IN_TRANSIT,
                        SampleStatusConstant.RECEIVED
                ))
                .count();
    }

    /**
     * 鑾峰彇寮傚父鏍囨湰鏁?     */
    private Long getAbnormalSampleCount() {
        return this.lambdaQuery()
                .eq(Sample::getStatus, SampleStatusConstant.ABNORMAL)
                .count();
    }

    /**
     * 鑾峰彇鏍囨湰鐘舵€佸垎甯?     */
    private List<SampleStatusStatsDTO> getSampleStatusDistribution() {
        List<SampleStatusStatsDTO> distribution = new ArrayList<>();
        
        // 鑾峰彇鍚勭姸鎬佹暟閲?        Map<String, Long> statusCounts = countByStatus();
        
        // 璁＄畻鎬绘暟
        Long total = statusCounts.values().stream().mapToLong(Long::longValue).sum();
        
        // 璁＄畻鏄ㄦ棩鏁版嵁鐢ㄤ簬瀵规瘮
        LocalDate yesterday = LocalDate.now().minusDays(1);
        List<Map<String, Object>> yesterdayCounts = baseMapper.countByStatusByDate(yesterday);
        Map<String, Long> yesterdayMap = yesterdayCounts.stream()
                .collect(Collectors.toMap(
                        map -> (String) map.get("status"),
                        map -> ((Number) map.get("count")).longValue()
                ));
        
        // 鏋勫缓鐘舵€佸垎甯僁TO
        for (Map.Entry<String, Long> entry : statusCounts.entrySet()) {
            String status = entry.getKey();
            Long count = entry.getValue();
            
            SampleStatusStatsDTO stats = new SampleStatusStatsDTO();
            stats.setStatus(status);
            stats.setStatusName(getStatusDesc(status));
            stats.setCount(count);
            
            // 璁＄畻鐧惧垎姣?            if (total > 0) {
                stats.setPercentage((count.doubleValue() / total) * 100);
            } else {
                stats.setPercentage(0.0);
            }
            
            // 璁＄畻杈冩槰鏃ュ彉鍖?            Long yesterdayCount = yesterdayMap.getOrDefault(status, 0L);
            stats.setChangeFromYesterday(count - yesterdayCount);
            
            distribution.add(stats);
        }
        
        return distribution;
    }

    /**
     * 鑾峰彇鏈€杩?澶╂爣鏈秼鍔?     */
    private Map<String, Long> getWeeklySampleTrend() {
        LocalDate endDate = LocalDate.now();
        LocalDate startDate = endDate.minusDays(6); // 鏈€杩?澶?        
        List<Map<String, Object>> trendData = baseMapper.countByDateRange(startDate, endDate);
        
        Map<String, Long> trendMap = new LinkedHashMap<>();
        
        // 鍒濆鍖栨渶杩?澶?        for (int i = 6; i >= 0; i--) {
            LocalDate date = endDate.minusDays(i);
            trendMap.put(date.format(DATE_FORMATTER), 0L);
        }
        
        // 濉厖瀹為檯鏁版嵁
        for (Map<String, Object> data : trendData) {
            String date = data.get("date").toString();
            Long count = ((Number) data.get("count")).longValue();
            trendMap.put(date, count);
        }
        
        return trendMap;
    }

    /**
     * 鑾峰彇鐘舵€佹弿杩?     */
    private String getStatusDesc(String status) {
        Map<String, String> descMap = new HashMap<>();
        descMap.put(SampleStatusConstant.COLLECTED, "宸查噰闆?);
        descMap.put(SampleStatusConstant.IN_TRANSIT, "杩愯緭涓?);
        descMap.put(SampleStatusConstant.RECEIVED, "宸叉帴鏀?);
        descMap.put(SampleStatusConstant.TESTING, "妫€楠屼腑");
        descMap.put(SampleStatusConstant.COMPLETED, "宸插畬鎴?);
        descMap.put(SampleStatusConstant.ARCHIVED, "宸插綊妗?);
        descMap.put(SampleStatusConstant.ABNORMAL, "寮傚父");
        return descMap.getOrDefault(status, "鏈煡鐘舵€?);
    }    private boolean isValidStatus(String status) {
        return Arrays.asList(
            SampleStatusConstant.COLLECTED,
            SampleStatusConstant.IN_TRANSIT,
            SampleStatusConstant.RECEIVED,
            SampleStatusConstant.TESTING,
            SampleStatusConstant.COMPLETED,
            SampleStatusConstant.ARCHIVED,
            SampleStatusConstant.ABNORMAL
        ).contains(status);
    }
}
