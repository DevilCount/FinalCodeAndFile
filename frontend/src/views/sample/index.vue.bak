<template>
  <div class="sample-container">
    <h2 class="page-title">标本管理</h2>
    
    <!-- 操作栏 -->
    <div class="action-bar">
      <el-button type="primary" @click="goToCreateSample">
        <el-icon><Plus /></el-icon>
        新建标本
      </el-button>
      <el-input
        v-model="searchQuery"
        placeholder="搜索标本编号或患者姓名"
        style="width: 300px; margin-left: 20px"
        prefix-icon="Search"
      />
      <el-select
        v-model="statusFilter"
        placeholder="按状态筛选"
        style="width: 150px; margin-left: 10px"
      >
        <el-option label="全部" value="" />
        <el-option label="待接收" value="PENDING" />
        <el-option label="已接收" value="RECEIVED" />
        <el-option label="检验中" value="TESTING" />
        <el-option label="已完成" value="COMPLETED" />
        <el-option label="异常" value="ABNORMAL" />
      </el-select>
    </div>
    
    <!-- 标本列表 -->
    <el-card shadow="hover" class="sample-card">
      <el-table :data="samples" style="width: 100%">
        <el-table-column prop="sampleNo" label="标本编号" width="180" />
        <el-table-column prop="patientName" label="患者姓名" width="120" />
        <el-table-column prop="patientId" label="患者ID" width="120" />
        <el-table-column prop="sampleType" label="标本类型" width="120" />
        <el-table-column prop="status" label="状态" width="100">
          <template #default="{ row }">
            <el-tag :type="getStatusType(row.status)">
              {{ getStatusText(row.status) }}
            </el-tag>
          </template>
        </el-table-column>
        <el-table-column prop="createTime" label="创建时间" width="180" />
        <el-table-column label="操作" width="200">
          <template #default="{ row }">
            <el-button
              type="primary"
              size="small"
              @click="goToSampleDetail(row.id)"
            >
              查看
            </el-button>
            <el-button
              type="success"
              size="small"
              @click="handleReceiveSample(row)"
              v-if="row.status === 'PENDING'"
            >
              接收
            </el-button>
            <el-button
              type="warning"
              size="small"
              @click="handleStartTest(row)"
              v-if="row.status === 'RECEIVED'"
            >
              开始检验
            </el-button>
            <el-button
              type="info"
              size="small"
              @click="handleCompleteTest(row)"
              v-if="row.status === 'TESTING'"
            >
              完成检验
            </el-button>
          </template>
        </el-table-column>
      </el-table>
      
      <!-- 分页 -->
      <div class="pagination">
        <el-pagination
          v-model:current-page="currentPage"
          v-model:page-size="pageSize"
          :page-sizes="[10, 20, 50, 100]"
          layout="total, sizes, prev, pager, next, jumper"
          :total="total"
          @size-change="handleSizeChange"
          @current-change="handleCurrentChange"
        />
      </div>
    </el-card>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { useRouter } from 'vue-router'
import { ElMessage, ElMessageBox } from 'element-plus'
import { Plus, Search } from '@element-plus/icons-vue'
import sampleService from '../../services/sampleService'

const router = useRouter()

// 搜索和筛选
const searchQuery = ref('')
const statusFilter = ref('')

// 分页
const currentPage = ref(1)
const pageSize = ref(10)
const total = ref(0)

// 标本列表
const samples = ref([])

// 状态映射
const statusMap = {
  PENDING: { text: '待接收', type: 'info' },
  RECEIVED: { text: '已接收', type: 'primary' },
  TESTING: { text: '检验中', type: 'warning' },
  COMPLETED: { text: '已完成', type: 'success' },
  ABNORMAL: { text: '异常', type: 'danger' }
}

// 方法
const getStatusText = (status) => {
  return statusMap[status]?.text || status
}

const getStatusType = (status) => {
  return statusMap[status]?.type || 'info'
}

const goToCreateSample = () => {
  router.push('/sample/create')
}

const goToSampleDetail = (id) => {
  router.push(`/sample/detail/${id}`)
}

const handleReceiveSample = (row) => {
  ElMessageBox.confirm('确定接收该标本吗？', '提示', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning'
  }).then(async () => {
    try {
      const user = JSON.parse(localStorage.getItem('user') || '{}')
      const response = await sampleService.receiveSample(row.id, user.id, user.realName)
      if (response.code === 200) {
        ElMessage.success('接收成功')
        // 刷新列表
        loadSamples()
      } else {
        ElMessage.error(response.message || '接收失败')
      }
    } catch (error) {
      ElMessage.error('接收失败，请检查网络连接')
      console.error('接收标本错误:', error)
    }
  })
}

const handleStartTest = (row) => {
  ElMessageBox.confirm('确定开始检验该标本吗？', '提示', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning'
  }).then(async () => {
    try {
      const user = JSON.parse(localStorage.getItem('user') || '{}')
      const response = await sampleService.startTest(row.id, user.id, user.realName)
      if (response.code === 200) {
        ElMessage.success('开始检验成功')
        // 刷新列表
        loadSamples()
      } else {
        ElMessage.error(response.message || '开始检验失败')
      }
    } catch (error) {
      ElMessage.error('开始检验失败，请检查网络连接')
      console.error('开始检验错误:', error)
    }
  })
}

const handleCompleteTest = (row) => {
  ElMessageBox.confirm('确定完成检验该标本吗？', '提示', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning'
  }).then(async () => {
    try {
      const user = JSON.parse(localStorage.getItem('user') || '{}')
      const response = await sampleService.completeTest(row.id, user.id, user.realName)
      if (response.code === 200) {
        ElMessage.success('完成检验成功')
        // 刷新列表
        loadSamples()
      } else {
        ElMessage.error(response.message || '完成检验失败')
      }
    } catch (error) {
      ElMessage.error('完成检验失败，请检查网络连接')
      console.error('完成检验错误:', error)
    }
  })
}

const handleSizeChange = (size) => {
  pageSize.value = size
  loadSamples()
}

const handleCurrentChange = (current) => {
  currentPage.value = current
  loadSamples()
}

const loadSamples = async () => {
  try {
    const response = await sampleService.listSamples()
    if (response.code === 200) {
      samples.value = response.data
      total.value = response.data.length
    } else {
      ElMessage.error(response.message || '获取标本列表失败')
    }
  } catch (error) {
    console.error('获取标本列表错误:', error)
    ElMessage.error('获取标本列表失败')
  }
}

// 生命周期
onMounted(() => {
  loadSamples()
})
</script>

<style lang="scss" scoped>
.sample-container {
  .action-bar {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .sample-card {
    .pagination {
      margin-top: 20px;
      display: flex;
      justify-content: flex-end;
    }
  }
}
</style>
