# ===========================================
# 开发环境配置 (.env.development)
# 仅在开发环境生效的配置项
# ===========================================

# 应用基础信息（开发环境）
VITE_APP_TITLE=实验室管理系统 [开发]

# API 配置（开发环境 - 连接本地后端）
VITE_API_BASE_URL=  # [Iter3] 空字符串=使用Vite代理（同源，避免CORS）
VITE_API_TIMEOUT=30000  # 开发环境超时时间更长，方便调试

# 功能开关（开发环境）
VITE_ENABLE_MOCK=true   # 开发环境启用Mock数据
VITE_ENABLE_AI_DIAGNOSIS=true

# 调试选项
VITE_DEV_SHOW_DEMO_HINT=true  # 显示演示账号提示
