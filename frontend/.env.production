# ===========================================
# 生产环境配置 (.env.production)
# 仅在生产环境生效的配置项
# ===========================================

# 应用基础信息（生产环境）
VITE_APP_TITLE=实验室管理系统

# API 配置（生产环境 - 使用相对路径，由Nginx代理）
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# 功能开关（生产环境）
VITE_ENABLE_MOCK=false
VITE_ENABLE_AI_DIAGNOSIS=true

# 安全选项
VITE_DEV_SHOW_DEMO_HINT=false  # 生产环境隐藏演示账号提示
