<?xml version="1.0" encoding="UTF-8"?>
<!--
    日志配置文件 - 带敏感数据脱敏功能
    
    脱敏规则：
    1. password/pwd/passwd 字段: 用 *** 替代
    2. token/jwt/authorization: 只显示前8位...后4位
    3. 手机号 (11位): 138****5678 格式
    4. 身份证号 (15/18位): 110***********1234 格式
    5. 银行卡号 (16-19位): 6222******90123 格式
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 定义日志输出格式 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_DIR" value="${user.dir}/logs"/>

    <!-- 引入 Spring Boot 默认配置 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 注册自定义脱敏转换器 -->
    <conversionRule conversionWord="msg" 
                     converterClass="com.sunyaxin.common.config.log.SensitiveDataConverter"/>

    <!-- ==================== 控制台输出 ==================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 文件输出 ==================== -->
    
    <!-- INFO级别日志文件 -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/user-service.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/user-service.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <!-- ERROR级别日志文件（单独记录错误） -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/user-service-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/user-service-error.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==================== 异步日志（提升性能） ==================== -->
    <appender name="ASYNC_FILE_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志，默认如果队列满80%，则丢弃TRACE、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列深度，该值会影响性能，默认值为256 -->
        <queueSize>1024</queueSize>
        <!-- 添加附加器，可以添加多个 -->
        <appender-ref ref="FILE_INFO"/>
    </appender>

    <appender name="ASYNC_FILE_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE_ERROR"/>
    </appender>

    <!-- ==================== 日志级别设置 ==================== -->
    
    <!-- Spring Boot 默认日志级别 -->
    <springProfile name="default,dev">
        <!-- 开发环境：显示详细日志 -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
        
        <!-- 项目包路径设置为 DEBUG -->
        <logger name="com.sunyaxin" level="DEBUG"/>
        
        <!-- SQL日志 -->
        <logger name="com.sunyaxin.user.mapper" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod,test">
        <!-- 生产环境：只输出重要日志 -->
        <root level="WARN">
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
        
        <!-- 项目包路径设置为 INFO -->
        <logger name="com.sunyaxin" level="INFO"/>
        
        <!-- 关闭SQL日志 -->
        <logger name="com.sunyaxin.user.mapper" level="WARN"/>
    </springProfile>

    <!-- 第三方框架日志级别控制 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.spring" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="com.baomidou.mybatisplus" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="org.springframework.cloud.gateway" level="INFO"/>

</configuration>
